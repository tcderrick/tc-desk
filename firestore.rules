rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function em() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && em() in ['tc@derrick.club']; }
    function isTeam() { return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/logins/$(em()))); }

    // Who may sign in. Only the admin edits this list (TC Desk keeps it in step with Templates > Team).
    match /logins/{email} {
      allow read: if signedIn() && (isAdmin() || email == em());
      allow write: if isAdmin();
    }
    // Each person's own saved filters and views.
    match /data/users/{uid}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Client portal: a person outside the team reads only the file views shared with their own email.
    match /portal/{id} {
      allow read: if signedIn() && resource.data.email == em();
    }
    // Portal chat: each person reads only their own thread, and may write only on a file shared with them that has chat turned on.
    match /pchat/{id} {
      allow read: if signedIn() && resource.data.email == em();
      allow create: if signedIn() && request.resource.data.email == em() && request.resource.data.from == 'client'
        && request.resource.data.keys().hasOnly(['id', 'txId', 'email', 'pid', 'from', 'by', 'text', 'at'])
        && (!('by' in request.resource.data) || (request.resource.data.by is string && request.resource.data.by.size() <= 160))
        && request.resource.data.text is string && request.resource.data.text.size() < 4000
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.email == em()
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.txId == request.resource.data.txId
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.data.show.chat == true;
    }
    // Sign-in link requests: a temporary guest asks the server to email a link (the server only sends to people who have access).
    match /linkreq/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.uid == request.auth.uid && request.resource.data.email is string
        && request.resource.data.email.size() < 200 && request.resource.data.keys().hasOnly(['uid', 'email', 'url', 'at']);
    }
    // Sign-ups: someone outside the team tells us who they are (their own record only).
    match /signups/{email} {
      allow read: if signedIn() && email == em();
      allow create, update: if signedIn() && email == em() && request.resource.data.email == em()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'company', 'phone', 'note', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
    }
    match /portalseen/{email} {
      allow read, write: if signedIn() && email == em();
    }
    // ---------- Other TCs' workspaces: each lives under ws/{id} and only its members can touch it ----------
    function memOk(m, w) { return m.ws == w && m.role in ['owner', 'member']; }
    function inWs(w) { return signedIn() && exists(/databases/$(database)/documents/wsmem/$(em())) && memOk(get(/databases/$(database)/documents/wsmem/$(em())).data, w); }
    function inWsAfter(w) { return signedIn() && memOk(getAfter(/databases/$(database)/documents/wsmem/$(em())).data, w); }
    function ownsAfter(w) { return getAfter(/databases/$(database)/documents/ws/$(w)).data.owner == em(); }
    function owns(w) { return get(/databases/$(database)/documents/ws/$(w)).data.owner == em(); }
    match /ws/{w} {
      allow read: if inWs(w) || isAdmin();
      // Anyone signed in can start a workspace, if they don't already belong to one.
      allow create: if signedIn() && request.resource.data.owner == em()
        && !exists(/databases/$(database)/documents/wsmem/$(em())) && !isTeam()
        && request.resource.data.keys().hasOnly(['owner', 'name', 'at']);
      allow update: if signedIn() && resource.data.owner == em() && request.resource.data.owner == em();
      // The owner can close their workspace; Derrick (admin) can remove any.
      allow delete: if signedIn() && (resource.data.owner == em() || isAdmin());
    }
    // Which workspace each person belongs to. The owner invites their team; each person accepts the invite themselves.
    match /wsmem/{email} {
      allow read: if signedIn() && (email == em() || isAdmin() || owns(resource.data.ws));
      allow create: if signedIn() && request.resource.data.ws is string && ownsAfter(request.resource.data.ws)
        && request.resource.data.keys().hasOnly(['ws', 'role', 'name', 'at'])
        && (email == em() ? request.resource.data.role == 'owner' : request.resource.data.role == 'invited');
      allow update: if signedIn() && ((owns(resource.data.ws) && request.resource.data.ws == resource.data.ws && request.resource.data.role == resource.data.role)
        || (email == em() && resource.data.role == 'invited' && request.resource.data.role == 'member' && request.resource.data.ws == resource.data.ws));
      allow delete: if signedIn() && ((owns(resource.data.ws) && email != em()) || email == em() || isAdmin());
    }
    // (at least one level below ws/{w}, so the workspace record itself only follows the rules above)
    match /ws/{w}/{col}/{rest=**} {
      allow read: if inWs(w);
      allow write: if inWsAfter(w);
    }
    // Portal and portal chat in any workspace: a client reads only what's shared with their own email.
    match /{path=**}/portal/{id} {
      allow read: if signedIn() && resource.data.email == em();
    }
    match /{path=**}/pchat/{id} {
      allow read: if signedIn() && resource.data.email == em();
    }
    match /ws/{w}/pchat/{id} {
      allow create: if signedIn() && request.resource.data.email == em() && request.resource.data.from == 'client'
        && request.resource.data.keys().hasOnly(['id', 'txId', 'email', 'pid', 'from', 'by', 'text', 'at'])
        && (!('by' in request.resource.data) || (request.resource.data.by is string && request.resource.data.by.size() <= 160))
        && request.resource.data.text is string && request.resource.data.text.size() < 4000
        && get(/databases/$(database)/documents/ws/$(w)/portal/$(request.resource.data.pid)).data.email == em()
        && get(/databases/$(database)/documents/ws/$(w)/portal/$(request.resource.data.pid)).data.txId == request.resource.data.txId
        && get(/databases/$(database)/documents/ws/$(w)/portal/$(request.resource.data.pid)).data.data.show.chat == true;
    }

    // Everything else: deals, contacts, templates, chat, settings. Your team only.
    match /{col}/{docId} {
      allow read, write: if !(col in ['logins', 'ws', 'wsmem']) && isTeam();
    }
  }
}
