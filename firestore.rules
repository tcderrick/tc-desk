rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function em() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && em() in ['tc@derrick.club']; }
    function isTeam() { return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/logins/$(em()))); }

    // Who may sign in. Only the admin edits this list (TC Desk keeps it in step with Templates > Team).
    match /logins/{email} {
      allow read: if signedIn() && (isAdmin() || email == em());
      allow write: if isAdmin();
    }
    // Each person's own saved filters and views.
    match /data/users/{uid}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Client portal: a person outside the team reads only the file views shared with their own email.
    match /portal/{id} {
      allow read: if signedIn() && resource.data.email == em();
    }
    // Portal chat: each person reads only their own thread, and may write only on a file shared with them that has chat turned on.
    match /pchat/{id} {
      allow read: if signedIn() && resource.data.email == em();
      allow create: if signedIn() && request.resource.data.email == em() && request.resource.data.from == 'client'
        && request.resource.data.text is string && request.resource.data.text.size() < 4000
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.email == em()
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.txId == request.resource.data.txId
        && get(/databases/$(database)/documents/portal/$(request.resource.data.pid)).data.data.show.chat == true;
    }
    // Sign-in link requests: a temporary guest asks the server to email a link (the server only sends to people who have access).
    match /linkreq/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.uid == request.auth.uid && request.resource.data.email is string
        && request.resource.data.email.size() < 200 && request.resource.data.keys().hasOnly(['uid', 'email', 'url', 'at']);
    }
    // Sign-ups: someone outside the team tells us who they are (their own record only).
    match /signups/{email} {
      allow read: if signedIn() && email == em();
      allow create, update: if signedIn() && email == em() && request.resource.data.email == em()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'company', 'phone', 'note', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
    }
    match /portalseen/{email} {
      allow read, write: if signedIn() && email == em();
    }
    // Everything else: deals, contacts, templates, chat, settings. Team only.
    match /{col}/{docId} {
      allow read, write: if col != 'logins' && isTeam();
    }
  }
}
